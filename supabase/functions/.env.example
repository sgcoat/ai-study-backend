# Only server-side settings. Do not copy these into the Expo app.
# Supabase URL and service/public keys are injected by the hosted Edge runtime.
AI_PROVIDER=mock
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Enable ONLY after saving email-templates/delete-account.html as Reauthentication.
ACCOUNT_DELETION_ENABLED=false
WEB_ORIGINS=http://localhost:8081
