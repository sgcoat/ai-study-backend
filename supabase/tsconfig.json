{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../server/node_modules/@types"],
    "allowImportingTsExtensions": true,
    "paths": { "npm:zod@4.6.5": ["../server/node_modules/zod"] }
  },
  "include": ["functions/**/*.ts"]
}
