{
  "name": "ai-study-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "mail:check": "node --env-file-if-exists=.env --import tsx src/scripts/checkMail.ts",
    "ai:check": "node --env-file-if-exists=.env --import tsx src/scripts/checkAI.ts",
    "gemini:check": "node --dns-result-order=ipv4first --env-file-if-exists=.env --import tsx src/scripts/checkGemini.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:types": "tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.16",
    "openai": "^7.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^7.0.11",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
