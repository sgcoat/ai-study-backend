NODE_ENV=development
# full: 전체 API / auth: 이메일 인증, 사용자 조회, 로그아웃, 계정 삭제 제공
SERVER_MODE=full
HOST=0.0.0.0
PORT=3000
# setup 명령이 로컬 인증/이미지 서명 비밀 값을 생성합니다.
AUTH_SECRET=
DATA_DIR=./data
ACCESS_TOKEN_DAYS=7
IMAGE_URL_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# 프록시 없이 실행할 때는 비워 둡니다. 배포 템플릿에서는 Caddy의 내부 IP를 지정합니다.
TRUSTED_PROXY_IPS=

# mock도 실제 HTTP/DB/작업 큐를 사용합니다. openai / gemini는 실제 AI를 호출합니다.
# 실제 AI + SMTP 실행: pnpm dev:ai (AI 사용료 발생). docs/AI_CONNECTION.md 참고.
AI_PROVIDER=mock
MOCK_AI_DELAY_MS=1500
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 무료 등급 Google AI Studio 프로젝트의 키 사용. pnpm dev:gemini / docs/GEMINI_CONNECTION.md
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=120000
DAILY_GENERATION_LIMIT=30

# console: 개발 터미널에서 인증 코드 확인 / smtp: 실제 이메일 발송
# 실제 이메일 실행: docs/EMAIL_SETUP.md를 따라 SMTP를 입력한 뒤 pnpm dev:email
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_DAILY_LIMIT_PER_ADDRESS=10
EMAIL_HOURLY_LIMIT=100
EMAIL_DAILY_LIMIT=500
