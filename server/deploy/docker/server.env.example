# Server runtime secrets only. Compose reads this file in raw format:
# do not wrap values in quotes, including EMAIL_FROM and SMTP_PASS.
SERVER_MODE=full
AUTH_SECRET=
ACCESS_TOKEN_DAYS=7
CORS_ORIGINS=

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_DAILY_LIMIT_PER_ADDRESS=10
EMAIL_HOURLY_LIMIT=100
EMAIL_DAILY_LIMIT=500

# AI 기능을 제외한 배포. 실제 AI 키 없이 로그인과 자료 관리를 사용할 수 있습니다.
AI_FEATURES_ENABLED=false
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=120000
DAILY_GENERATION_LIMIT=30
IMAGE_URL_TTL_SECONDS=3600
